// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// prisma/schema.prisma

datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile       UserProfile?
  settings      UserSettings?
  answers       CompatibilityAnswer[]
  shortlists    Shortlist[]           @relation("UserShortlistOwner")
  shortlistedBy Shortlist[]           @relation("UserShortlistTarget")
  createdRooms  ChatRoom[]            @relation("ChatRoomCreator")
  participants  ChatRoomParticipant[]
  messages      ChatMessage[]
  resetTokens   PasswordResetToken[]

  householdMemberships  HouseholdMember[]
  createdHouseholds     Household[]        @relation("HouseholdCreator")
  sentHouseholdInvites  HouseholdInvite[]  @relation("HouseholdInviter")
  addedShoppingItems    ShoppingItem[]     @relation("ShoppingItemAdder")
  checkedShoppingItems  ShoppingItem[]     @relation("ShoppingItemChecker")
  createdChores         Chore[]            @relation("ChoreCreator")
  startedChores         Chore[]            @relation("ChoreStarter")
  choreCompletions      ChoreCompletion[]
  householdMessages     HouseholdMessage[]
  paidExpenses          Expense[]          @relation("ExpensePayer")
  createdExpenses       Expense[]          @relation("ExpenseCreator")
  expenseShares         ExpenseShare[]
  settlementsSent       Settlement[]       @relation("SettlementFrom")
  settlementsReceived   Settlement[]       @relation("SettlementTo")
  createdSettlements    Settlement[]       @relation("SettlementCreator")
  ruleProposals         RuleProposal[]
  ruleVotes             RuleVote[]
  calendarEventsCreated CalendarEvent[]    @relation("CalendarEventCreator")
  calendarEntries       CalendarEvent[]    @relation("CalendarEventAbout")
  feedback              Feedback[]

  @@index([username])
}

model Household {
  id               String    @id @default(uuid())
  name             String
  joinCode         String    @unique
  createdByUserId  String?
  createdByUser    User?     @relation("HouseholdCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  // The matching chat room this household was formed from, if any. A room forms at most one household.
  sourceChatRoomId String?   @unique
  sourceChatRoom   ChatRoom? @relation(fields: [sourceChatRoomId], references: [id], onDelete: SetNull)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  members        HouseholdMember[]
  invites        HouseholdInvite[]
  settings       HouseholdSettings?
  shoppingItems  ShoppingItem[]
  chores         Chore[]
  messages       HouseholdMessage[]
  expenses       Expense[]
  settlements    Settlement[]
  houseRules     HouseRule[]
  ruleProposals  RuleProposal[]
  calendarEvents CalendarEvent[]

  @@index([joinCode])
}

model HouseholdMember {
  id            String    @id @default(uuid())
  householdId   String
  userId        String
  role          String // 'owner' | 'member'
  status        String // 'active' | 'left' | 'removed'
  // When they last became active; household chat shows messages from then on.
  joinedAt      DateTime  @default(now())
  // Newest household chat message they've seen; later ones from others are unread.
  chatReadAt    DateTime?
  // When they agreed to the house rules; before joinedAt means not since they (re)joined.
  rulesAgreedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
  @@index([householdId])
}

model HouseholdInvite {
  id              String    @id @default(uuid())
  householdId     String
  email           String
  token           String    @unique
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  declinedAt      DateTime?
  createdAt       DateTime  @default(now())

  household     Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  invitedByUser User?     @relation("HouseholdInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([householdId])
  @@index([token])
  @@index([email])
}

model HouseholdSettings {
  householdId String    @id
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  chatEnabled     Boolean @default(true)
  choresEnabled   Boolean @default(true)
  shoppingEnabled Boolean @default(true)
  expensesEnabled Boolean @default(false)
  calendarEnabled Boolean @default(true)
  rulesEnabled    Boolean @default(true)

  // ISO 4217 code; every amount in the household is in this currency.
  currency String @default("USD")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HouseholdMessage {
  id           String   @id @default(uuid())
  householdId  String
  senderUserId String
  text         String
  createdAt    DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  sender    User      @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([householdId, createdAt])
}

model ShoppingItem {
  id              String    @id @default(uuid())
  householdId     String
  name            String
  quantity        String?
  addedByUserId   String?
  checkedAt       DateTime?
  checkedByUserId String?
  // The expense this item was bought on ("I bought these").
  expenseId       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  household     Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  addedByUser   User?     @relation("ShoppingItemAdder", fields: [addedByUserId], references: [id], onDelete: SetNull)
  checkedByUser User?     @relation("ShoppingItemChecker", fields: [checkedByUserId], references: [id], onDelete: SetNull)
  expense       Expense?  @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([householdId])
}

model Chore {
  id              String    @id @default(uuid())
  householdId     String
  name            String
  // Both null: a one-off chore, archived once it's done.
  repeatEvery     Int?
  repeatUnit      String? // 'day' | 'week' | 'month' | 'quarter'
  dueDate         DateTime  @db.Date
  // Day of the month monthly/quarterly chores fall on (a chore on the 31st
  // is due on the 30th or 28th in shorter months, then back on the 31st).
  anchorDay       Int
  // User ids taking turns, in order; rotationIndex is whose turn it is.
  // Members who have left are skipped when the turn is worked out.
  rotation        String[]
  rotationIndex   Int       @default(0)
  archivedAt      DateTime?
  // "Someone is on it"; cleared when the chore is done.
  startedAt       DateTime?
  startedByUserId String?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  household     Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdByUser User?             @relation("ChoreCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  startedByUser User?             @relation("ChoreStarter", fields: [startedByUserId], references: [id], onDelete: SetNull)
  completions   ChoreCompletion[]

  @@index([householdId])
}

model ChoreCompletion {
  id                    String   @id @default(uuid())
  choreId               String
  doneByUserId          String?
  // The occurrence that was done, and the day it was done (the user's local date).
  dueDate               DateTime @db.Date
  completedOn           DateTime @db.Date
  // Whose turn it was, so an undo can put the turn back.
  previousRotationIndex Int
  createdAt             DateTime @default(now())

  chore      Chore @relation(fields: [choreId], references: [id], onDelete: Cascade)
  doneByUser User? @relation(fields: [doneByUserId], references: [id], onDelete: SetNull)

  @@index([choreId])
}

// Amounts are whole cents in the household's currency.
model Expense {
  id              String   @id @default(uuid())
  householdId     String
  description     String
  amountCents     Int
  paidByUserId    String
  spentOn         DateTime @db.Date
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  household     Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  paidByUser    User           @relation("ExpensePayer", fields: [paidByUserId], references: [id], onDelete: Cascade)
  createdByUser User?          @relation("ExpenseCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  shares        ExpenseShare[]
  shoppingItems ShoppingItem[]

  @@index([householdId, spentOn])
}

// What each person owes of an expense; shares add up to the expense amount.
model ExpenseShare {
  id          String @id @default(uuid())
  expenseId   String
  userId      String
  amountCents Int

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
  @@index([userId])
}

// Money paid back between members ("Sam paid Alex $40").
model Settlement {
  id              String   @id @default(uuid())
  householdId     String
  fromUserId      String
  toUserId        String
  amountCents     Int
  paidOn          DateTime @db.Date
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  household     Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  fromUser      User      @relation("SettlementFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser        User      @relation("SettlementTo", fields: [toUserId], references: [id], onDelete: Cascade)
  createdByUser User?     @relation("SettlementCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([householdId, paidOn])
}

// An adopted house rule. Rules only change through a RuleProposal everyone agreed to.
model HouseRule {
  id          String   @id @default(uuid())
  householdId String
  title       String
  details     String?
  adoptedAt   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  proposals RuleProposal[]

  @@index([householdId, adoptedAt])
}

// A proposed new rule, change or removal; adopted once every active member agrees.
model RuleProposal {
  id               String    @id @default(uuid())
  householdId      String
  kind             String // 'add' | 'change' | 'remove'
  ruleId           String?
  // The proposed text; for a removal, the rule's text when it was proposed.
  title            String
  details          String?
  reason           String?
  proposedByUserId String?
  status           String    @default("open") // 'open' | 'adopted' | 'declined' | 'withdrawn'
  decidedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  household  Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  rule       HouseRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  proposedBy User?      @relation(fields: [proposedByUserId], references: [id], onDelete: SetNull)
  votes      RuleVote[]

  @@index([householdId, status])
}

// A household event, or an away/guest entry about one member. Dates are
// calendar days and times are the house's clock time ("19:00"), with no time
// zone. Only events repeat (the chore repeat rules) or have times.
model CalendarEvent {
  id              String     @id @default(uuid())
  householdId     String
  kind            String // 'event' | 'away' | 'guest'
  // Who an away/guest entry is about (the host, for a guest).
  userId          String?
  // Required for an event; the guest for a guest entry ("My sister").
  title           String?
  notes           String?
  startsOn        DateTime   @db.Date
  endsOn          DateTime   @db.Date
  startTime       String?
  endTime         String?
  // Both null: no repeat.
  repeatEvery     Int?
  repeatUnit      String? // 'day' | 'week' | 'month' | 'quarter'
  anchorDay       Int
  // Occurrences of a repeating event that were skipped.
  skippedDates    DateTime[] @db.Date
  createdByUserId String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  household     Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user          User?     @relation("CalendarEventAbout", fields: [userId], references: [id], onDelete: Cascade)
  createdByUser User?     @relation("CalendarEventCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([householdId, startsOn])
  @@index([userId])
  @@index([createdByUserId])
}

model RuleVote {
  id         String   @id @default(uuid())
  proposalId String
  userId     String
  agree      Boolean
  reason     String?
  createdAt  DateTime @default(now())

  proposal RuleProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([proposalId, userId])
  @@index([userId])
}

model UserProfile {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName     String
  lastName      String
  displayName   String?
  birthDate     DateTime
  school        String
  collegeYear   String
  originalCity  String?
  originalState String?
  targetCity    String
  targetState   String
  targetZip     String
  bio           String?
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CompatibilityQuestion {
  id         String   @id @default(uuid())
  code       String   @unique
  text       String
  helperText String?
  type       String
  options    Json?
  category   String   @default("general")
  isActive   Boolean  @default(true)
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  answers CompatibilityAnswer[]
}

model CompatibilityAnswer {
  id         String   @id @default(uuid())
  userId     String
  questionId String
  value      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  question CompatibilityQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model Shortlist {
  id           String   @id @default(uuid())
  ownerUserId  String
  targetUserId String
  createdAt    DateTime @default(now())

  owner  User @relation("UserShortlistOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  target User @relation("UserShortlistTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, targetUserId])
}

model ChatRoom {
  id              String   @id @default(uuid())
  createdByUserId String?
  createdByUser   User?    @relation("ChatRoomCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  name            String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  participants ChatRoomParticipant[]
  messages     ChatMessage[]
  household    Household?
}

model ChatRoomParticipant {
  id         String    @id @default(uuid())
  chatRoomId String
  userId     String
  status     String // 'pending', 'accepted', 'declined', 'removed', 'left'
  role       String // 'owner', 'member'
  // When they last accepted (null unless accepted): the longest-standing
  // accepted participant becomes owner when the owner leaves.
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatRoomId, userId])
  @@index([userId])
  @@index([chatRoomId])
}

model ChatMessage {
  id           String   @id @default(uuid())
  chatRoomId   String
  senderUserId String
  text         String
  createdAt    DateTime @default(now())

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  sender   User     @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([chatRoomId, createdAt])
}

model UserSettings {
  userId                         String   @id
  user                           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailNotificationsEnabled      Boolean  @default(true)
  chatInviteNotificationsEnabled Boolean  @default(true)
  marketingNotificationsEnabled  Boolean  @default(false)
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// "Report a problem" from the nav. Read with `npm run feedback`; there is no
// screen for it in the app.
model Feedback {
  id             String   @id @default(uuid())
  userId         String
  message        String
  page           String
  viewport       String?
  userAgent      String?
  appVersion     String?
  screenshot     Bytes?
  screenshotType String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, createdAt])
}
